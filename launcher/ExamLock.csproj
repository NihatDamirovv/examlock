<Project Sdk="Microsoft.NET.Sdk">
  <!--
    ExamLock — tələbənin imtahan proqramı (Windows, WebView2).
    Bu kod mövcud ExamLock.exe-dən bərpa edilib (decompile), sonra düzəldilib.

    Yığmaq (serverdəki /srv/examlock/bin/ExamLock.exe üçün):
      dotnet publish -c Release
    Nəticə: bin\Release\net10.0-windows\win-x64\publish\ExamLock.exe
  -->
  <PropertyGroup>
    <AssemblyName>ExamLock</AssemblyName>
    <RootNamespace>ExamLock</RootNamespace>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>True</UseWindowsForms>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>annotations</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>
</Project>
